<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="cloink-ui.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Cloink">
    </Installer>
    <PackageInformation
        PackageName="Cloink"
        PackageDisplayName="Cloink"
        PublisherName="CN=Cloink"
        PublisherDisplayName="Cloink"
        Version="0.0.1.0"
        PackageDescription="Cloink desktop client">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.cloink.client"
                Description="Cloink desktop client"
                DisplayName="Cloink"
                ExecutableName="cloink-ui.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Cloink</DisplayName>
            <PublisherDisplayName>Cloink</PublisherDisplayName>
            <Description>Cloink desktop client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="cloink-ui.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
