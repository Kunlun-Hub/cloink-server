{{ $projectName := env.Getenv "PROJECT" }}{{ $amdFilePath := env.Getenv "AMD" }}{{ $armFilePath := env.Getenv "ARM" }}
{{ $amdURL := env.Getenv "AMD_URL" }}{{ $armURL := env.Getenv "ARM_URL" }}
{{ $amdFile := filepath.Base $amdFilePath }}{{ $armFile := filepath.Base $armFilePath }}{{ $amdFileBytes := file.Read $amdFilePath }}
{{ $armFileBytes := file.Read $armFilePath }}# Cloink's UI Client Cask Formula
cask "{{ $projectName }}" do
  version "{{ env.Getenv "VERSION" }}"

  if Hardware::CPU.intel?
      url "{{ $amdURL }}"
      sha256 "{{ crypto.SHA256 $amdFileBytes }}"
      app "cloink_ui_darwin", target: "Cloink UI.app"
  else
      url "{{ $armURL }}"
      sha256 "{{ crypto.SHA256 $armFileBytes }}"
      app "cloink_ui_darwin", target: "Cloink UI.app"
  end

  depends_on formula: "cloink"

  postflight_steps do
    set_permissions ["Cloink UI.app/installer.sh", "Cloink UI.app/uninstaller.sh"], "0755",
                    base: :appdir, recursive: false
    run "Cloink UI.app/installer.sh", args: ["#{version}"], base: :appdir, sudo: true
  end

  uninstall_preflight_steps do
    run "/bin/launchctl", args: ["bootout", "system/cloink"], sudo: true, must_succeed: false
    run "/bin/launchctl", args: ["unload", "/Library/LaunchDaemons/cloink.plist"],
        sudo: true, must_succeed: false
    remove "/Library/LaunchDaemons/cloink.plist", sudo: true
  end

  name "Cloink UI"
  desc "Cloink UI Client"
  homepage "https://cloink.4w.ink/"
end
