#!/bin/sh

set -u

LOG_DIR=/var/log/cloink
LOG_FILE=$LOG_DIR/client_post_install.log
APP=/Applications/Cloink.app
AGENT=/usr/local/bin/cloink
PLIST=/Library/LaunchDaemons/cloink.plist
SOCKET=/var/run/cloink.sock

start_service() {
    if launchctl print system/cloink >/dev/null 2>&1; then
        launchctl enable system/cloink >/dev/null 2>&1 || true
        launchctl kickstart -k system/cloink
        return $?
    fi

    if launchctl bootstrap system "$PLIST"; then
        launchctl enable system/cloink >/dev/null 2>&1 || true
        launchctl kickstart -k system/cloink
        return $?
    fi

    echo "launchctl bootstrap failed; falling back to cloink service start."
    "$AGENT" service start
}

write_diagnostics() {
    echo "Cloink service diagnostics:"
    ls -l "$PLIST" "$AGENT" "$SOCKET" 2>&1 || true
    plutil -lint "$PLIST" 2>&1 || true
    launchctl print system/cloink 2>&1 || true
    tail -n 100 /var/log/cloink/client.log 2>&1 || true
    tail -n 100 /var/log/cloink.err.log 2>&1 || true
    tail -n 100 /var/log/cloink.out.log 2>&1 || true
}

mkdir -p "$LOG_DIR" /usr/local/bin

{
    echo "Starting Cloink postinstall at $(date -u '+%Y-%m-%dT%H:%M:%SZ')."

    if [ ! -x "$APP/Contents/MacOS/cloink-ui" ]; then
        echo "Cloink UI executable is missing from $APP."
        exit 1
    fi
    if [ ! -x "$APP/Contents/MacOS/cloink" ]; then
        echo "Cloink daemon executable is missing from $APP."
        exit 1
    fi
    if [ ! -f "$APP/Contents/Resources/icons.icns" ]; then
        echo "Cloink app icon is missing from $APP."
        exit 1
    fi

    touch "$APP"
    lsregister=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
    if [ -x "$lsregister" ]; then
        "$lsregister" -f "$APP" || true
    fi

    ln -sfn "$APP/Contents/MacOS/cloink" "$AGENT"
    echo "Installed the cloink command at $AGENT."

    if [ -f "$PLIST" ]; then
        echo "Existing launchd configuration found; reconfiguring the service."
        if ! "$AGENT" service reconfigure; then
            echo "Service reconfigure failed; retrying a clean service install."
            launchctl bootout system/cloink >/dev/null 2>&1 || true
            if ! "$AGENT" service install; then
                echo "Cloink service installation failed."
                write_diagnostics
                exit 1
            fi
        fi
    elif ! "$AGENT" service install; then
        echo "Cloink service installation failed."
        write_diagnostics
        exit 1
    fi

    if [ ! -f "$PLIST" ]; then
        echo "Cloink launchd configuration was not created at $PLIST."
        write_diagnostics
        exit 1
    fi

    chown root:wheel "$PLIST"
    chmod 0644 "$PLIST"
    if ! plutil -lint "$PLIST"; then
        echo "Cloink launchd configuration is invalid."
        write_diagnostics
        exit 1
    fi

    if ! start_service; then
        echo "Cloink service start command failed."
        write_diagnostics
        exit 1
    fi

    waited=0
    while [ "$waited" -lt 20 ]; do
        [ -S "$SOCKET" ] && break
        sleep 1
        waited=$((waited + 1))
    done
    if [ ! -S "$SOCKET" ]; then
        echo "Cloink service did not create $SOCKET within 20 seconds."
        write_diagnostics
        exit 1
    fi

    console_user=$(stat -f%Su /dev/console 2>/dev/null)
    case "$console_user" in
        ""|root|loginwindow|_mbsetupuser)
            echo "No active GUI user session (console user: '${console_user:-none}'); skipping UI launch."
            ;;
        *)
            uid=$(id -u "$console_user" 2>/dev/null)
            if [ -z "$uid" ]; then
                echo "Could not resolve uid for console user '$console_user'; skipping UI launch."
            else
                echo "Launching Cloink as console user $console_user (uid $uid)."
                launchctl asuser "$uid" sudo -u "$console_user" -H open "$APP" || true
            fi
            ;;
    esac

    echo "Cloink postinstall complete."
    exit 0
} >>"$LOG_FILE" 2>&1
